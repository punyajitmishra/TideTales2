{
  "name": "tidetales",
  "version": "1.0.0",
  "description": "Grounded coastal and climate time-series storytelling for coastal communities",
  "author": "Punyajit Mishra",
  "private": true,
  "main": "server/index.js",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "server": "node server/index.js",
    "client": "npm --prefix client start",
    "dev": "concurrently -n server,client -c cyan,green \"npm run server\" \"npm run client\"",
    "start": "node server/index.js",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18"
  }
}
